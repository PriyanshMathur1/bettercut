{
  "name": "bettercut-composer",
  "version": "1.0.0",
  "private": true,
  "description": "BetterCut renderer (Remotion) and browser editor",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "editor:build": "vite build --config editor/vite.config.ts",
    "editor:dev": "vite --config editor/vite.config.ts",
    "test": "node --test tests/reel/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/player": "4.0.484",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.3.0",
    "vite": "^5.4.11"
  }
}
