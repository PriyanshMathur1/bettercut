# Copy to .env and fill in. Never commit .env.

# Where the site lives. No domain? Use your server's IP with dashes + .sslip.io,
# e.g. 140-238-1-2.sslip.io : it resolves to the IP and gets a free HTTPS certificate.
SITE_ADDRESS=140-238-1-2.sslip.io
PUBLIC_URL=https://140-238-1-2.sslip.io

# Sign-in: Supabase Auth, Google only.
AUTH_MODE=supabase
AUTH_PROVIDERS=google
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Leave empty for new Supabase projects (they sign with public keys). Only legacy projects need it.
SUPABASE_JWT_SECRET=
# Private beta: comma-separated emails allowed to sign in. Empty = anyone with a Google account.
ALLOWED_EMAILS=

# Encrypts users' model keys and signs media links. Generate once:  openssl rand -base64 32
# Keep a copy somewhere safe: if it's lost, every user has to re-enter their model key.
BETTERCUT_SECRET=

# Database. Empty = a SQLite file on the data volume (fine for a beta on one server).
# For Postgres:  postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Media storage. "local" keeps files on the server's disk (200 GB on Oracle's free tier).
# For Cloudflare R2 set STORAGE=s3 and fill the rest (endpoint: https://<account-id>.r2.cloudflarestorage.com).
STORAGE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Limits that keep a small free server healthy
WORKERS=1
MAX_UPLOAD_MB=500
MAX_CLIP_SECONDS=180
MAX_PROJECTS=25
RENDERS_PER_DAY=20
ALLOW_CUTOUT=0
