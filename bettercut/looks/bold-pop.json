      "vignette": 0.25,
      "grain": 0
    },
    "hook": {
      "style": "slam",
      "duration": 2.2
    },
    "endCard": {
      "enabled": true,
      "style": "follow",
      "text": "Follow for more",
      "duration": 2.5
    },
    "progressBar": true
  }
}